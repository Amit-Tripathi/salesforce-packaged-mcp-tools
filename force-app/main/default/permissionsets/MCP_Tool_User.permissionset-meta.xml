<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>MCP Tool User</label>
    <description>Lets users call the packaged MCP Apex tools (Get Account Insights and MCP Demo create/read/update/delete) through a Salesforce Hosted MCP Server.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses><apexClass>McpAccountInsights</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>McpDemoCreate</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>McpDemoDelete</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>McpDemoRead</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>McpDemoUpdate</apexClass><enabled>true</enabled></classAccesses>
    <fieldPermissions><editable>true</editable><field>MCP_Demo__c.Amount__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>MCP_Demo__c.Description__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>MCP_Demo__c.Due_Date__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>MCP_Demo__c.Status__c</field><readable>true</readable></fieldPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>MCP_Demo__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <tabSettings><tab>MCP_Demo__c</tab><visibility>Visible</visibility></tabSettings>
</PermissionSet>
